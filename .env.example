# Local progress database
VB_DB_PATH=./data/local/progress.db
# Folder with content bundles
VB_CONTENT_DIR=./data/sample
# Default language: ta (Tamil) or en (English)
VB_DEFAULT_LANG=ta
# Central sync endpoint. Leave empty for fully offline operation
VB_SYNC_URL=
# Bearer token for the sync endpoint (needed only if VB_SYNC_URL is set)
VB_SYNC_TOKEN=
# Secret for signing certificate codes. Replace with a long random value
VB_CERT_SECRET=change-me-to-a-long-random-string
